{
  "name": "zfr-magpie",
  "version": "0.1.1",
  "description": "Magpie / OpenCode provider plugin that fronts the local zfr-core gateway (OpenCode Zen + Kilo free models with multi-egress IP rotation).",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "provider.mjs",
    "models.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "assets/icon.svg",
    "assets/icon.png",
    "assets/icon-128.png"
  ],
  "keywords": [
    "magpie",
    "opencode",
    "opencode-plugin",
    "zfr",
    "zfr-core",
    "zen",
    "kilo",
    "egress-rotation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ksmord/zfr-magpie"
  },
  "bugs": {
    "url": "https://github.com/ksmord/zfr-magpie/issues"
  },
  "scripts": {
    "check": "node --check index.mjs && node --check provider.mjs && node --check models.mjs",
    "upstream": "node scripts/check-upstream.mjs",
    "test": "node --test test/"
  },
  "magpie": {
    "maxConcurrency": 2,
    "upstream": "wayne091106-hash/zfr-core"
  }
}
